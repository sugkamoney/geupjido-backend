# 실제 값은 EC2의 /etc/geupjido/dev.env에만 입력한다.
# 비밀번호가 포함된 파일은 저장소에 추가하지 않는다.
DB_URL=jdbc:postgresql://RDS_PRIVATE_HOST:5432/geupjido?sslmode=verify-full&sslrootcert=/etc/geupjido/rds-global-bundle.pem
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD
# 주간 실거래가 갱신은 입력 파일 배포와 서버의 한 조합 검증 전까지 끈다.
# 공공데이터포털 인증키는 이 예시 파일에 실제 값을 쓰지 않는다.
# DATA_GO_KR_SERVICE_KEY=REPLACE_WITH_SERVICE_KEY
# DATA_GO_KR_APT_TRADE_ENABLED=false
# WEEKLY_TRADE_REFRESH_SCHEDULE_ENABLED=false
# WEEKLY_TRADE_REFRESH_MAPPING_PATH=/opt/geupjido/data/location/mapping/location-mapping.json
# WEEKLY_TRADE_REFRESH_REFERENCE_PATH=/opt/geupjido/data/location/reference/legal-dongs-20260917.tsv
# WEEKLY_TRADE_REFRESH_REPORT_PATH=/var/lib/geupjido/trade/weekly-dev.tsv
# 브라우저에서 개발 API를 직접 호출하는 출처만 쉼표로 구분해 입력한다.
# WORLDCUP_CORS_ALLOWED_ORIGINS=REPLACE_WITH_EXACT_ORIGINS
# 개발 서버의 급지·순위 집계는 한국 시간 3시간 간격으로 기본 실행된다.
# 필요할 때만 아래 값을 명시해 예약 실행을 끈다.
# WORLDCUP_RATING_SCHEDULE_ENABLED=false
# 주간 리포트는 일요일 18시 마감값을 준비하고 21시 이후 공개한다.
# 필요할 때만 아래 값을 명시해 예약 실행을 끈다.
# WEEKLY_REPORT_SCHEDULE_ENABLED=false
