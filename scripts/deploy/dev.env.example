# 실제 값은 EC2의 /etc/geupjido/dev.env에만 입력한다.
# 비밀번호가 포함된 파일은 저장소에 추가하지 않는다.
DB_URL=jdbc:postgresql://RDS_PRIVATE_HOST:5432/geupjido?sslmode=verify-full&sslrootcert=/etc/geupjido/rds-global-bundle.pem
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_RDS_PASSWORD
# 브라우저에서 개발 API를 직접 호출하는 출처만 쉼표로 구분해 입력한다.
# WORLDCUP_CORS_ALLOWED_ORIGINS=REPLACE_WITH_EXACT_ORIGINS
